{
    "config": {
        "LSQ_API_URL": "https://api.lemonsqueezy.test",
        "LSQ_APP_URL": "https://app.lemonsqueezy.test",
        "LSQ_OAUTH_CLIENT_ID": "",
        "WP_DEBUG": true,
        "SCRIPT_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false
    },
    "plugins": [
        ".",
        "https://downloads.wordpress.org/plugin/query-monitor.zip",
        "https://downloads.wordpress.org/plugin/plugin-check.zip"
    ],
    "phpVersion": "8.4",
    "lifecycleScripts": {
        "install": "composer install",
        "build": "node --version && yarn --version && yarn install && yarn build",
        "afterStart": "wp-env run cli wp rewrite structure /%postname%/ --hard && wp-env run cli wp rewrite flush --hard"
    },
}
